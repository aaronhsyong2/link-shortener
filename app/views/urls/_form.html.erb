<%= form_with(model: url) do |form| %>
  <% if url.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 mb-4">
      <h3 class="text-sm font-medium text-red-800">
        <%= pluralize(url.errors.count, "error") %> prevented this URL from being shortened:
      </h3>
      <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
        <% url.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <%= form.label :target_url, "Enter your URL", class: "block text-sm font-medium text-gray-700" %>
    <%= form.url_field :target_url,
      placeholder: "https://example.com/very/long/url/that/needs/shortening",
      autofocus: true,
      class: ["block w-full rounded-lg border px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition",
        url.errors[:target_url].none? ? "border-gray-300" : "border-red-400 ring-red-200"] %>

    <%= form.submit "Shorten URL",
      class: "w-full rounded-lg px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm cursor-pointer transition" %>
  </div>
<% end %>
