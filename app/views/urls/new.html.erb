<% content_for :title, "Shorten a URL" %>

<div class="max-w-xl mx-auto mt-8">
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white">Shorten your URL</h1>
    <p class="mt-3 text-lg text-gray-500 dark:text-gray-400">Paste a long URL and get a short, shareable link</p>
  </div>

  <div class="card p-6">
    <%= render "form", url: @url %>
  </div>
</div>

<%= render "recent_urls", recent_urls: @recent_urls %>
