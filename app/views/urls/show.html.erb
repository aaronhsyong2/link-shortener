<% content_for :title, @url.title || "URL Details" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">URL Details</h1>

  <div class="card overflow-hidden">
    <div class="p-6 space-y-5">
      <div>
        <label class="label">Short URL</label>
        <div class="flex items-center space-x-3">
          <code class="text-lg font-mono text-blue-600 break-all">
            <%= short_redirect_url(short_code: @url.short_code) %>
          </code>
          <button
            data-controller="clipboard"
            data-clipboard-short-url-value="<%= short_redirect_url(short_code: @url.short_code) %>"
            data-action="click->clipboard#copy"
            class="shrink-0 rounded-md bg-gray-100 hover:bg-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 transition cursor-pointer"
          >
            Copy
          </button>
        </div>
      </div>

      <div>
        <label class="label">Target URL</label>
        <p class="text-sm text-gray-900 break-all">
          <%= link_to @url.target_url, safe_url(@url.target_url), target: "_blank", class: "link" %>
        </p>
      </div>

      <div class="flex space-x-8">
        <div>
          <label class="label">Title</label>
          <p class="text-sm text-gray-900"><%= @url.display_title %></p>
        </div>
        <div>
          <label class="label">Clicks</label>
          <p class="text-sm text-gray-900"><%= @url.clicks_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-gray-50 border-t border-gray-200 px-6 py-4 flex space-x-3">
      <%= link_to "View Report", url_report_path(@url), class: "btn-primary" %>
      <%= link_to "Shorten Another", root_path, class: "btn-secondary" %>
      <%= link_to "All URLs", urls_path, class: "btn-secondary" %>
    </div>
  </div>
</div>
