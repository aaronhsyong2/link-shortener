<% content_for :title, "All URLs" %>
<%= turbo_stream_from "url_titles" %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white">All URLs</h1>
  <%= link_to "Shorten URL", new_url_path, class: "btn-primary" %>
</div>

<% if @urls.any? %>
  <div class="card overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-700">
        <tr>
          <th class="th">Short Code</th>
          <th class="th">Target URL</th>
          <th class="th">Title</th>
          <th class="th text-right">Clicks</th>
          <th class="th text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @urls.each do |url| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="td">
              <%= link_to url.slug, short_redirect_url(slug: url.slug),
                class: "font-mono link", target: "_blank", data: { turbo: false } %>
            </td>
            <td class="td max-w-xs truncate text-gray-600 dark:text-gray-400">
              <%= link_to truncate(url.target_url, length: 50), safe_url(url.target_url),
                target: "_blank", class: "hover:underline", title: url.target_url %>
            </td>
            <td class="td">
              <%= render "urls/title", url: url %>
            </td>
            <td class="td text-right font-medium">
              <%= url.clicks_count %>
            </td>
            <td class="td text-right space-x-2">
              <%= link_to "Details", url, class: "text-sm link" %>
              <%= link_to "Report", url_report_path(url), class: "text-sm link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @urls.total_pages > 1 %>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800 flex justify-center">
        <%= paginate @urls %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card p-12 text-center">
    <p class="text-gray-500 dark:text-gray-400 mb-4">No URLs shortened yet.</p>
    <%= link_to "Shorten your first URL", new_url_path, class: "link font-medium" %>
  </div>
<% end %>
