<% content_for :title, "Report for #{@url.slug}" %>
<%= turbo_stream_from @url %>

<div class="mb-6">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Usage Report</h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <%= link_to short_redirect_url(slug: @url.slug), short_redirect_url(slug: @url.slug),
      class: "font-mono link", target: "_blank", data: { turbo: false } %>
    &rarr;
    <%= link_to truncate(@url.target_url, length: 60), safe_url(@url.target_url),
      target: "_blank", class: "link", title: @url.target_url %>
  </p>
</div>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
  <div class="card p-5">
    <p class="label">Total Clicks</p>
    <p class="mt-1 text-3xl font-bold text-gray-900 dark:text-white"><%= render "reports/clicks_count", url: @url %></p>
  </div>
  <div class="card p-5">
    <p class="label">Countries</p>
    <p class="mt-1 text-3xl font-bold text-gray-900 dark:text-white"><%= @analytics.visits_by_country.size %></p>
  </div>
  <div class="card p-5">
    <p class="label">First Click</p>
    <p class="mt-1 text-sm font-medium text-gray-900 dark:text-gray-100"><%= @analytics.first_click&.strftime("%b %d, %Y") || "—" %></p>
  </div>
  <div class="card p-5">
    <p class="label">Last Click</p>
    <p class="mt-1 text-sm font-medium text-gray-900 dark:text-gray-100"><%= @analytics.last_click&.strftime("%b %d, %Y") || "—" %></p>
  </div>
</div>

<div data-controller="tabs" class="mb-8">
  <nav class="flex overflow-x-auto space-x-6 border-b border-gray-200 dark:border-gray-700 mb-6 -mx-1 px-1">
    <a href="#overview" data-tabs-target="tab" data-tab="overview" data-action="click->tabs#switch"
       class="pb-3 text-sm tab-active">Overview</a>
    <a href="#devices" data-tabs-target="tab" data-tab="devices" data-action="click->tabs#switch"
       class="pb-3 text-sm tab-inactive">Devices</a>
    <a href="#traffic" data-tabs-target="tab" data-tab="traffic" data-action="click->tabs#switch"
       class="pb-3 text-sm tab-inactive">Traffic Sources</a>
    <a href="#recent" data-tabs-target="tab" data-tab="recent" data-action="click->tabs#switch"
       class="pb-3 text-sm tab-inactive">Recent</a>
  </nav>

  <div data-tabs-target="panel" data-tab="overview">
    <%= render "reports/overview_tab" %>
  </div>

  <div data-tabs-target="panel" data-tab="devices" hidden>
    <%= render "reports/devices_tab" %>
  </div>

  <div data-tabs-target="panel" data-tab="traffic" hidden>
    <%= render "reports/traffic_tab" %>
  </div>

  <div data-tabs-target="panel" data-tab="recent" hidden>
    <%= render "reports/recent_tab" %>
  </div>
</div>

<div class="flex space-x-3">
  <%= link_to "Back to URL Details", url_path(@url), class: "btn-secondary" %>
  <%= link_to "All URLs", urls_path, class: "btn-secondary" %>
</div>
