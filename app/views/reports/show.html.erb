<% content_for :title, "Report for #{@url.short_code}" %>

<div class="mb-6">
  <h1 class="text-3xl font-bold text-gray-900">Usage Report</h1>
  <p class="mt-1 text-sm text-gray-500">
    <%= link_to short_redirect_url(short_code: @url.short_code), short_redirect_url(short_code: @url.short_code),
      class: "font-mono link" %>
    &rarr;
    <%= link_to truncate(@url.target_url, length: 60), safe_url(@url.target_url),
      target: "_blank", class: "link", title: @url.target_url %>
  </p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <div class="card p-5">
    <p class="label">Total Clicks</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @analytics.total_clicks %></p>
  </div>
  <div class="card p-5">
    <p class="label">Countries</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @analytics.visits_by_country.size %></p>
  </div>
  <div class="card p-5">
    <p class="label">Title</p>
    <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= @url.display_title %></p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-sm font-semibold text-gray-900">Clicks by Country</h2>
    </div>
    <% if @analytics.visits_by_country.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="th">Country</th>
            <th class="th text-right">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @analytics.visits_by_country.each do |country, count| %>
            <tr class="hover:bg-gray-50">
              <td class="td"><%= country %></td>
              <td class="td text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
    <% end %>
  </div>

  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-sm font-semibold text-gray-900">Clicks by City</h2>
    </div>
    <% if @analytics.visits_by_city.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="th">City</th>
            <th class="th text-right">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @analytics.visits_by_city.each do |city, count| %>
            <tr class="hover:bg-gray-50">
              <td class="td"><%= city %></td>
              <td class="td text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
    <% end %>
  </div>
</div>

<div class="card overflow-hidden mb-8">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <h2 class="text-sm font-semibold text-gray-900">Recent Visits</h2>
  </div>
  <% if @analytics.recent_visits.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr>
          <th class="th">Timestamp</th>
          <th class="th">IP Address</th>
          <th class="th">Country</th>
          <th class="th">City</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @analytics.recent_visits.each do |visit| %>
          <tr class="hover:bg-gray-50">
            <td class="td text-gray-600 font-mono"><%= visit.visited_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
            <td class="td text-gray-600 font-mono"><%= visit.ip_address %></td>
            <td class="td"><%= visit.country %></td>
            <td class="td"><%= visit.city %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
  <% end %>
</div>

<div class="flex space-x-3">
  <%= link_to "Back to URL Details", url_path(@url), class: "btn-secondary" %>
  <%= link_to "All URLs", urls_path, class: "btn-secondary" %>
</div>
