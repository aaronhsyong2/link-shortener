<% content_for :title, "Report for #{@url.short_code}" %>

<div class="mb-6">
  <h1 class="text-3xl font-bold text-gray-900">Usage Report</h1>
  <p class="mt-1 text-sm text-gray-500">
    <%= link_to short_redirect_url(short_code: @url.short_code), short_redirect_url(short_code: @url.short_code),
      class: "font-mono text-blue-600 hover:underline" %>
    &rarr;
    <%= link_to truncate(@url.target_url, length: 60), safe_url(@url.target_url),
      target: "_blank", class: "text-blue-600 hover:underline", title: @url.target_url %>
  </p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total Clicks</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @total_clicks %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Countries</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @visits_by_country.size %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Title</p>
    <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= @url.title || "No title available" %></p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-sm font-semibold text-gray-900">Clicks by Country</h2>
    </div>
    <% if @visits_by_country.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Country</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @visits_by_country.sort_by { |_, count| -count }.each do |country, count| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 text-sm text-gray-900"><%= country %></td>
              <td class="px-6 py-3 text-sm text-gray-900 text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-sm font-semibold text-gray-900">Clicks by City</h2>
    </div>
    <% if @visits_by_city.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">City</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @visits_by_city.sort_by { |_, count| -count }.each do |city, count| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 text-sm text-gray-900"><%= city %></td>
              <td class="px-6 py-3 text-sm text-gray-900 text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-8">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <h2 class="text-sm font-semibold text-gray-900">Recent Visits</h2>
  </div>
  <% if @visits.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Timestamp</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Country</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">City</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @visits.each do |visit| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-3 text-sm text-gray-600 font-mono"><%= visit.visited_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
            <td class="px-6 py-3 text-sm text-gray-600 font-mono"><%= visit.ip_address %></td>
            <td class="px-6 py-3 text-sm text-gray-900"><%= visit.country %></td>
            <td class="px-6 py-3 text-sm text-gray-900"><%= visit.city %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-500 text-center">No visits yet.</p>
  <% end %>
</div>

<div class="flex space-x-3">
  <%= link_to "Back to URL Details", url_path(@url),
    class: "rounded-lg px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium transition" %>
  <%= link_to "All URLs", urls_path,
    class: "rounded-lg px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium transition" %>
</div>
