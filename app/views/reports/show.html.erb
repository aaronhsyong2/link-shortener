<% content_for :title, "Report for #{@url.slug}" %>
<%= turbo_stream_from @url %>

<div class="mb-6">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Usage Report</h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    <%= link_to short_redirect_url(slug: @url.slug), short_redirect_url(slug: @url.slug),
      class: "font-mono link", target: "_blank", data: { turbo: false } %>
    &rarr;
    <%= link_to truncate(@url.target_url, length: 60), safe_url(@url.target_url),
      target: "_blank", class: "link", title: @url.target_url %>
  </p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <div class="card p-5">
    <p class="label">Total Clicks</p>
    <p class="mt-1 text-3xl font-bold text-gray-900 dark:text-white"><%= render "reports/clicks_count", url: @url %></p>
  </div>
  <div class="card p-5">
    <p class="label">Countries</p>
    <p class="mt-1 text-3xl font-bold text-gray-900 dark:text-white"><%= @analytics.visits_by_country.size %></p>
  </div>
  <div class="card p-5">
    <p class="label">Title</p>
    <p class="mt-1 text-sm font-medium text-gray-900 dark:text-gray-100 truncate"><%= @url.display_title %></p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-700">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Clicks by Country</h2>
    </div>
    <% if @analytics.visits_by_country.any? %>
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead>
          <tr>
            <th class="th">Country</th>
            <th class="th text-right">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @analytics.visits_by_country.each do |country, count| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="td"><%= country %></td>
              <td class="td text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 dark:text-gray-400 text-center">No visits yet.</p>
    <% end %>
  </div>

  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-700">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Clicks by City</h2>
    </div>
    <% if @analytics.visits_by_city.any? %>
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead>
          <tr>
            <th class="th">City</th>
            <th class="th text-right">Clicks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @analytics.visits_by_city.each do |city, count| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="td"><%= city %></td>
              <td class="td text-right font-medium"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-gray-500 dark:text-gray-400 text-center">No visits yet.</p>
    <% end %>
  </div>
</div>

<div class="card overflow-hidden mb-8">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-700">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Recent Visits</h2>
  </div>
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
    <thead>
      <tr>
        <th class="th">Timestamp</th>
        <th class="th">IP Address</th>
        <th class="th">Location</th>
      </tr>
    </thead>
    <tbody id="visits" class="divide-y divide-gray-200 dark:divide-gray-700">
      <%= render partial: "reports/visit_row", collection: @analytics.recent_visits, as: :visit %>
    </tbody>
  </table>
</div>

<div class="flex space-x-3">
  <%= link_to "Back to URL Details", url_path(@url), class: "btn-secondary" %>
  <%= link_to "All URLs", urls_path, class: "btn-secondary" %>
</div>
