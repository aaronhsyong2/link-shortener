<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="card p-6">
    <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">Browsers</h3>
    <%= pie_chart @analytics.visits_by_browser, height: "250px", donut: true,
      colors: ["#2563eb", "#7c3aed", "#db2777", "#ea580c", "#65a30d", "#0891b2"],
      library: pie_chart_library_options, empty: "No data yet" %>
  </div>
  <div class="card p-6">
    <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">Operating Systems</h3>
    <%= pie_chart @analytics.visits_by_os, height: "250px", donut: true,
      colors: ["#2563eb", "#7c3aed", "#db2777", "#ea580c", "#65a30d", "#0891b2"],
      library: pie_chart_library_options, empty: "No data yet" %>
  </div>
  <div class="card p-6 md:col-span-2">
    <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">Device Types</h3>
    <%= bar_chart @analytics.visits_by_device_type, height: "200px", colors: ["#3b82f6"],
      library: chart_library_options, empty: "No data yet" %>
  </div>
</div>
