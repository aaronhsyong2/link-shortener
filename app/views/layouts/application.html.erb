<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Link Shortener" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-gray-50">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex justify-between items-center">
        <%= link_to root_path, class: "flex items-center space-x-2" do %>
          <span class="text-xl font-bold text-blue-600">LinkShortener</span>
        <% end %>
        <div class="flex space-x-6">
          <%= link_to "Shorten", root_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
          <%= link_to "All URLs", urls_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <% if notice.present? %>
        <div class="mb-6 rounded-lg bg-green-50 border border-green-200 p-4" id="notice">
          <p class="text-sm font-medium text-green-800"><%= notice %></p>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4" id="alert">
          <p class="text-sm font-medium text-red-800"><%= alert %></p>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
