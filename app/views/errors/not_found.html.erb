<% content_for(:title, "Page not found (404) — LinkShortener") %>

<div class="flex items-center justify-center min-h-[60vh]">
  <div class="text-center max-w-md px-6">
    <div class="text-8xl font-extrabold text-blue-600 dark:text-blue-400 leading-none">404</div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-4">Page not found</h1>
    <p class="text-gray-500 dark:text-gray-400 mt-2">The page you're looking for doesn't exist or may have been removed.</p>
    <%= link_to "Shorten a URL", root_path,
        class: "inline-block mt-6 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition dark:bg-blue-500 dark:hover:bg-blue-600" %>
  </div>
</div>
