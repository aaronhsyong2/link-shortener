<%= paginator.render do -%>
  <nav class="flex items-center gap-1" role="navigation" aria-label="pager">
    <%= first_page_tag %>
    <%= prev_page_tag %>
    <% each_page do |page| -%>
      <% if page.display_tag? -%>
        <%= page_tag page %>
      <% elsif !page.was_truncated? -%>
        <%= gap_tag %>
      <% end -%>
    <% end -%>
    <%= next_page_tag %>
    <%= last_page_tag %>
  </nav>
<% end -%>
